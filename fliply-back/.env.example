# ============================================
# FLIPLY - Arquivo de Configuração de Ambiente
# ============================================
# Copie este arquivo para .env e preencha com seus valores

# ============================================
# 🔐 SEGURANÇA - JWT Authentication
# ============================================
# Secret key para assinar tokens JWT
# ⚠️ IMPORTANTE: Gere uma chave forte e única para produção
# Exemplo: openssl rand -base64 32
JWT_SECRET=fliply-super-secret-key-must-be-at-least-256-bits-long-for-hs256

# Tempo de expiração do token em milissegundos
# Padrão: 86400000 (24 horas)
JWT_EXPIRATION=86400000

# ============================================
# 🔔 FIREBASE - Push Notifications (FCM)
# ============================================
# Console: https://console.firebase.google.com/
# Passo a passo no final deste arquivo

# ID do projeto Firebase (aba "Configurações do Projeto")
FIREBASE_PROJECT_ID=seu-projeto-id

# Email da conta de serviço (aba "Contas de serviço" → Gerar chave)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@seu-projeto.iam.gserviceaccount.com

# Chave privada da conta de serviço (campo private_key do JSON baixado)
# ⚠️ Mantenha as quebras de linha como \n — não coloque a chave sem escape
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgk...\n-----END PRIVATE KEY-----\n

# ============================================
# 🤖 INTEGRAÇÕES EXTERNAS
# ============================================
# Google Gemini AI - Para avaliação de respostas
# Obtenha em: https://ai.google.dev/
AI_API_KEY=sua-chave-gemini-aqui

# WhatsApp via Uazap - Para desafios automáticos
# Obtenha em: https://uazap.com/
UAZAP_URL=https://api.uazapi.com/send-message
UAZAP_TOKEN=seu-token-uazap-aqui

# ============================================
# 🌐 CONFIGURAÇÃO DA APLICAÇÃO
# ============================================
# URL base da aplicação (para links em emails)
APP_URL=http://localhost:5173

# Nome da aplicação (usado em templates de email)
APP_NAME=Fliply

# ============================================
# 🔒 CORS - Origens Permitidas
# ============================================
# Lista de origens que podem fazer requisições para a API
# Separadas por vírgula
ALLOWED_ORIGINS=http://localhost:5173,http://192.168.15.7:5173,capacitor://localhost,ionic://localhost

# ============================================
# 📊 BANCO DE DADOS
# ============================================
# Já configurado em application.properties (SQLite)
# Para mudar para PostgreSQL em produção:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/fliply
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=sua-senha

# ============================================
# 📝 LOGGING
# ============================================
# Nível de log da aplicação
# Opções: TRACE, DEBUG, INFO, WARN, ERROR
LOGGING_LEVEL=INFO

# ============================================
# 🚀 SERVIDOR
# ============================================
# Porta da API
# Padrão: 8080
SERVER_PORT=8080

# ============================================
# ⚠️  IMPORTANTE - ANTES DE COLOCAR EM PRODUÇÃO
# ============================================
# 1. Altere todas as chaves secretas (JWT_SECRET)
# 2. Configure credenciais reais de email (SMTP)
# 3. Adicione chave de API do Gemini
# 4. Configure token do Uazap
# 5. Configure credenciais do Firebase
# 6. Configure ALLOWED_ORIGINS com domínios reais
# 7. Mude para banco de dados PostgreSQL
# 8. Configure HTTPS/SSL
# 9. NUNCA faça commit deste arquivo com valores reais

# ============================================
# 📋 GUIA: CONFIGURAR FIREBASE
# ============================================
#
# PASSO 1 — Criar projeto Firebase
#   → https://console.firebase.google.com/
#   → "Adicionar projeto" → dê um nome → Criar
#
# PASSO 2 — Adicionar app Android
#   → Ícone Android → Package name: com.flashmind.app
#   → Baixe o google-services.json
#   → Coloque em: fliply-capacitor/android/app/google-services.json
#
# PASSO 3 — Gerar chave da Conta de Serviço (Backend)
#   → Configurações do Projeto (⚙️) → "Contas de serviço"
#   → Selecione "Admin SDK do Firebase" → "Gerar nova chave privada"
#   → Um arquivo JSON será baixado
#
# PASSO 4 — Preencher as variáveis abaixo com os valores do JSON:
#   {
#     "project_id":   → FIREBASE_PROJECT_ID
#     "client_email": → FIREBASE_CLIENT_EMAIL
#     "private_key":  → FIREBASE_PRIVATE_KEY  (substitua \n por \\n)
#   }
#
# PASSO 5 — Adicionar google-services.json ao app Android
#   → fliply-capacitor/android/app/google-services.json
#
# PASSO 6 — Sincronizar Capacitor
#   cd fliply-capacitor && npx cap sync android
